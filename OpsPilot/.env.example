# Required for the LLM-powered agent. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=2500
# Retries with exponential backoff on rate limits / transient errors
GEMINI_MAX_RETRIES=4
GEMINI_TIMEOUT_SECONDS=60

# Local project data (relative paths are resolved from the project root)
OPSILOT_DATA_DIR=./data
OPSILOT_DB_PATH=./data/opspilot.db
OPSILOT_CHROMA_PATH=./data/chroma
OPSILOT_APPROVALS_DIR=./data/approvals
OPSILOT_REPORTS_DIR=./data/reports
OPSILOT_KNOWLEDGE_DIR=./knowledge

# LlamaIndex embeddings (downloaded and run locally on CPU by default)
OPSILOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
OPSILOT_TOP_K=4
